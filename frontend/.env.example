# In local dev, Vite proxies /api to http://localhost:4000 (see vite.config.ts).
# For a production static host that cannot proxy, point the frontend at the API origin.
VITE_API_ORIGIN=

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
